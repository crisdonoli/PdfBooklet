; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "PdfBooklet"
#define MyAppPublisher "Thomas"
#define MyAppVersion "3.1.4e"

[Setup]
AppName={#MyAppName}
AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
DefaultDirName="C:\Util\PdfBooklet"
UsePreviousGroup=false
DisableProgramGroupPage=yes
DefaultGroupName={#MyAppName} {#MyAppVersion}
Compression=lzma
SolidCompression=true
ShowLanguageDialog=yes
;
DefaultUserInfoName=""
DefaultUserInfoOrg=""
UsePreviousUserInfo=Yes
UserInfoPage=No
;
OutputDir=.
SourceDir=.
OutputBaseFilename={#MyAppName} {#MyAppVersion} Setup
;VersionInfoVersion={#MyAppVersion}
VersionInfoCompany={#MyAppPublisher}
VersionInfoDescription={#MyAppName}
;InfoBeforeFile=InnoLicense.txt
WizardImageFile=FondPdfBookShuffler.bmp
WizardImageBackColor=clGreen
WizardSmallImageFile=MiniPdfBookShuffler.bmp
AllowNoIcons=true
WizardImageStretch=true

[Languages]
Name: english; MessagesFile: compiler:Default.isl
Name: french; MessagesFile: compiler:Languages\French.isl
;Name: spanish; MessagesFile: compiler:Languages\Spanish.isl

[Files]
Source: "d:\Mes documents\en cours\PdfBooklet-Thomas\dist\pdfbooklet314\*"; DestDir: "{app}"; Flags: ignoreversion overwritereadonly createallsubdirs recursesubdirs

[Dirs]

[Icons]
Name: {group}\{cm:UninstallProgram,{#MyAppName}}; Filename: {uninstallexe}
Name: {group}\PdfShuffler; Filename: {app}\pdfshuffler.exe; WorkingDir: {app}; IconFilename: {app}\pdfshuffler.ico; IconIndex: 0; Parameters:
Name: {commondesktop}\PdfShuffler; Filename: {app}\pdfshuffler; WorkingDir: {app}; IconFilename: {app}\pdfshuffler.ico; IconIndex: 0; Parameters:
Name: {group}\PdfBooklet; Filename: {app}\pdfBooklet.exe; WorkingDir: {app}; IconFilename: {app}\pdfbooklet.ico; IconIndex: 0; Parameters:
Name: {commondesktop}\PdfBooklet; Filename: {app}\pdfBooklet.exe; WorkingDir: {app}; IconFilename: {app}\pdfbooklet.ico; IconIndex: 0; Parameters:

[Run]

[Registry]

[Code]
[Code]
var
  Langue:    	String;
//
// Fonction qui sera éxécutée tout à la fin de l'installation pour placer la langue choisie
//
procedure DeinitializeSetup();
var
  FromFile:  	String;
  ToFile:    	String;
  AppDir:       String;

begin
  Langue:=ActiveLanguage();
//AppDir:= ExpandConstant('{app}');
  AppDir:= WizardDirValue();

//MsgBox(AppDir, mbInformation, MB_OK);

  if DirExists(AppDir) then begin
//   MsgBox(Langue, mbInformation, MB_OK);

     if Langue = 'english' then begin
        FromFile:= AppDir + '\share\locale\fr\LC_MESSAGES';
        ToFile:= AppDir + '\share\locale\fr\LC_MESSAGES.EN';
//      MsgBox(ToFile, mbInformation, MB_OK);
        RenameFile(FromFile,ToFile);
     end;
  end;
end;
